# Supabase
# Get these from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Instagram / Meta App
# Get these from Meta for Developers > Your App > App Settings.
NEXT_PUBLIC_INSTAGRAM_APP_ID=123456789012345
INSTAGRAM_APP_ID=123456789012345
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Must match the redirect URI configured in your Meta app.
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=https://your-domain.com/api/instagram/callback

# Any random string you choose, then use the same value in Meta webhook setup.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your-instagram-webhook-verify-token

# AI Gateway / Auto Reply
# Any random secret shared between your app and AI gateway.
GATEWAY_SECRET=your-ai-gateway-secret

# Internal API Hooks
# Any random secret used to protect internal API endpoints or cron hooks.
API_SECRET_KEY=your-internal-api-secret

# Instagram comment automation limits
INSTAGRAM_COMMENT_COOLDOWN_MINUTES=2
INSTAGRAM_COMMENT_AUTOMATION_HOURLY_LIMIT=120
INSTAGRAM_COMMENT_AUTOMATION_DAILY_LIMIT=1000

# Session cookie signing
# Any long random string. Falls back to INSTAGRAM_APP_SECRET if unset.
SESSION_SECRET=your-long-random-session-secret

# Your app's own origin. Used to bounce an unauthenticated YouTube connect
# attempt back to the landing page. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# YouTube / Google OAuth (Post section)
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Enable "YouTube Data API v3" on the same project.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Must be listed verbatim as an Authorized redirect URI on that OAuth client.
YOUTUBE_REDIRECT_URI=https://your-domain.com/api/youtube/callback

# Uploads are forced to private until the API project passes YouTube's
# compliance audit, so private is the honest default.
YOUTUBE_DEFAULT_PRIVACY=private

# YouTube video category id. 22 = People & Blogs.
YOUTUBE_CATEGORY_ID=22
